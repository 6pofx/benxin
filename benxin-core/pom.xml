<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.benxin</groupId>
        <artifactId>benxin</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>benxin-core</artifactId>
    <packaging>jar</packaging>
    <name>benxin-core</name>
    <description>本心核心：零 Spring 依赖的统一 LLM 抽象、协议编解码、工具与 Agent Loop 引擎</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
          工具参数与返回值里的 Optional<T> 靠它才能绑定。README 承诺"参数支持 Optional"，
          而 core 是纯 Java 模块，不能指望宿主的 Spring Boot 恰好把它带上 classpath，
          因此这里显式声明（Json 门面会通过 findAndRegisterModules() 自动发现它）。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <!--
          可选：仅"声明式工作流"的 YAML 入口需要它。
          core 里所有 YAML 调用都走反射（见 workflow/YamlSupport），因此没引这个依赖时
          依然能编译、能跑，只是 YAML 入口报一句明确的"请改用 JSON 或引入 snakeyaml"。
          Spring Boot 应用无需操心 —— spring-boot-starter 已经带了 snakeyaml。
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试期日志后端：没有它 surefire 会打印 "No SLF4J providers were found"，
             而且测试里的 warn/error 会被静默吞掉，排障时看不到任何线索。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
